dup 109 /m put
dup 110 /n put
dup 57 /nine put
dup 111 /o put
dup 49 /one put
dup 112 /p put
dup 40 /parenleft put
dup 41 /parenright put
dup 37 /percent put
dup 43 /plus put
dup 59 /semicolon put
dup 55 /seven put
dup 54 /six put
dup 51 /three put
dup 50 /two put
dup 120 /x put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
